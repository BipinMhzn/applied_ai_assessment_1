.venv
.idea
.DS_Store
__pycache__/
*.pyc
.ipynb_checkpoints/

# Raw crawl (1.1 GB, regenerable via data_collection.ipynb) stays local;
# only the clean catalog is needed at runtime, so keep that one tracked.
dataset/*

# Regenerable training artifacts stay local (X_train.npz alone is ~500 MB).
# Only the files app.py loads at runtime are tracked:
outputs/*
!outputs/vectorizer.joblib
!outputs/model_selection.json
!outputs/embeddings_all.npz

# LaTeX build directories (report lives in report/)
report/build/
report/out/

# LaTeX and bibliography intermediate files
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.toc
*.lof
*.lot
*.dvi
*.xdv
*.synctex
*.synctex.gz
*.synctex.gz(busy)

# Compiled documents generated alongside their source files
report/main.pdf

# Keep PDF figures and reference PDFs tracked; do not ignore *.pdf.
